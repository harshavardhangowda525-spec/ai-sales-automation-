# ─── App ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public URL of this backend (used for proposal PDF links + Sarvam webhook URL)
PUBLIC_BASE_URL=https://infinity-automation-api.onrender.com
# Dashboard origin(s), comma-separated — used for CORS
FRONTEND_URL=https://infinity-automation-dashboard.onrender.com
# Password for the dashboard (and the API behind it). Use a long random string.
ADMIN_TOKEN=
# Shared secret appended to the webhook URL (?secret=...) — Sarvam doesn't sign webhooks
SARVAM_WEBHOOK_SECRET=

# ─── Database (Neon Postgres) ──────────────────────────────────────────
DATABASE_URL=

# ─── Sarvam AI (Voice Agents) ──────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Telephony connection used to dial out (Sarvam dashboard → Connections)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Sales agent that calls leads (default for /api/campaign/start)
SARVAM_SALES_AGENT_ID=
SARVAM_SALES_AGENT_VERSION=1
# Summary agent that calls Harshavardhan when a campaign ends
SARVAM_SUMMARY_AGENT_ID=
SARVAM_SUMMARY_AGENT_VERSION=1
HARSHAVARDHAN_PHONE=+91XXXXXXXXXX
# Number printed on proposals ("Questions? WhatsApp us: ...") — defaults to HARSHAVARDHAN_PHONE
HARSHAVARDHAN_WHATSAPP=

# ─── Meetings without Google ───────────────────────────────────────────
# Consultations always appear on the dashboard's private Calendar page.
# Without Google credentials: MEETING_ROOM_URL (e.g. your permanent Meet link) is used for every
# meeting; leave it empty to give each consultation its own free Jitsi Meet room.
MEETING_ROOM_URL=

# ─── Google Calendar / Meet ────────────────────────────────────────────
# Optional: only if you want events on Google Calendar too
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/oauth2callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Working days for consultations (0=Sun … 6=Sat)
WORKING_DAYS=1,2,3,4,5,6

# ─── WhatsApp Cloud API (Meta) ─────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template name (see README). "none" = free-form text (only within a 24h window)
WHATSAPP_TEMPLATE_NAME=infinity_proposal
WHATSAPP_TEMPLATE_LANG=en
# Set false if your template has no DOCUMENT header
WHATSAPP_TEMPLATE_HAS_DOCUMENT=true

# ─── GitHub (one private repo per client website, seeded with CLAUDE.md) ─
# Fine-grained token: All repositories → Administration: Read & write, Contents: Read & write
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_PREFIX=iwa-

# ─── Calls to Harsha (one Sarvam agent for leads + Harsha) ─────────────
SARVAM_ASSISTANT_AGENT_ID=
SARVAM_ASSISTANT_AGENT_VERSION=1
REQUIRE_QUOTATION_APPROVAL=true
OWNER_CALL_START_HOUR=9
OWNER_CALL_END_HOUR=21
WHATSAPP_WEBSITE_TEMPLATE_NAME=infinity_website_ready

# ─── OpenAI (transcript parsing) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Branding ──────────────────────────────────────────────────────────
BUSINESS_EMAIL=akagaminodfshanks@gmail.com
BUSINESS_WEBSITE=infinity-web-apps.com
