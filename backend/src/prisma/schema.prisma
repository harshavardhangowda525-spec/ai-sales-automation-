// Infinity Web & Apps — Sales Automation schema
// All timestamps are stored as timestamptz (UTC instants) and rendered in IST (Asia/Kolkata).

generator client {
  provider      = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  RUNNING
  COMPLETED
}

enum CallOutcome {
  BOOKED
  REJECTED
  NO_ANSWER
  CALLBACK_LATER
  MANUAL // added by sir (Jarvis or dashboard), not from a sales call
}

enum PlanInterest {
  BASIC
  PREMIUM
  ADVANCED
  UNKNOWN
}

enum PortalStatus {
  NEW_LEAD
  PROPOSAL_SENT
  MEETING_SCHEDULED
  CONVERTED
  LOST
}

model Campaign {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  status             CampaignStatus @default(RUNNING)
  total_calls        Int            @default(0)
  booked             Int            @default(0)
  rejected           Int            @default(0)
  no_answer          Int            @default(0)
  callback_later     Int            @default(0)
  // Sarvam-side identifiers (so webhooks carrying Sarvam's own campaign id map to this row)
  sarvam_campaign_id String?        @unique
  cohort_id          String?
  agent_id           String?
  summary_call_sent  Boolean        @default(false)
  engine             String         @default("sarvam") // sarvam | infinity_voice (sir's own phone line)
  contacts           Json?          // [{ phone, business_name }] uploaded with the campaign
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?      @db.Timestamptz(6)

  clients     Client[]
  owner_calls OwnerCall[]

  @@map("campaigns")
}

model Client {
  id                String       @id @default(uuid()) @db.Uuid
  campaign_id       String?      @db.Uuid
  call_id           String?      @unique // Sarvam call id — makes webhook processing idempotent
  business_name     String
  phone_number      String
  contact_name      String?
  email             String?
  call_outcome      CallOutcome
  plan_interest     PlanInterest @default(UNKNOWN)
  requirements      String?      @db.Text
  preferred_time    String?
  duration_seconds  Int?
  meeting_link      String?
  meeting_time      DateTime?    @db.Timestamptz(6)
  calendar_event_id String?
  proposal_sent     Boolean      @default(false)
  proposal_url      String?
  portal_status     PortalStatus @default(NEW_LEAD)
  transcript        String?      @db.Text
  notes             String?      @db.Text
  website_url       String?
  website_sent      Boolean      @default(false)
  website_stage     WebsiteStage @default(NOT_STARTED)
  website_prompt    String?      @db.Text // CLAUDE.md brief for Claude Code
  website_prompt_source String?   // template (legacy rows may say groq)
  website_prompt_at DateTime?    @db.Timestamptz(6)
  website_preview_url String?
  github_repo         String?   // owner/name of the client's private website repo
  github_repo_url     String?
  build_status        String?   // requested | running | success | failure
  build_run_url       String?
  build_requested_at  DateTime? @db.Timestamptz(6)
  build_finished_at   DateTime? @db.Timestamptz(6)
  // Client Portal (client-portal-delta-liart.vercel.app) integration
  awaiting_email        Boolean   @default(false) // asked on WhatsApp for their email, waiting for the reply
  portal_client_id      String?
  portal_proposal_id    String?
  portal_proposal_link  String?
  portal_invite_link    String?
  portal_synced_at      DateTime? @db.Timestamptz(6)
  // Infinity Voice: call eligibility (TRAI — no unsolicited automated calls without consent)
  quote                 Json?     // { plan, addons: [{ key, qty }] } — built by Jarvis / dashboard (quoteBuilder.js)
  voice_consent         Boolean   @default(false) // agreed to receive calls from the AI agent
  do_not_call           Boolean   @default(false) // opted out — never call again
  consent_note          String?   @db.Text
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @updatedAt @db.Timestamptz(6)

  campaign    Campaign?   @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  call_logs   CallLog[]
  proposals   Proposal[]
  owner_calls OwnerCall[]

  @@index([campaign_id])
  @@index([call_outcome])
  @@index([created_at])
  @@map("clients")
}

model CallLog {
  id        String   @id @default(uuid()) @db.Uuid
  client_id String?  @db.Uuid // nullable so system-level errors can be logged too
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now()) @db.Timestamptz(6)

  client Client? @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([timestamp])
  @@map("call_logs")
}

// Proposal PDFs are stored in Postgres (Neon) and served publicly by the backend at
// GET /proposals/:id.pdf — no separate object storage needed.
model Proposal {
  id         String   @id @default(uuid()) @db.Uuid
  seq        Int      @unique @default(autoincrement()) // drives IWA-YYYY-NNNN numbering
  number     String   @unique
  client_id  String   @db.Uuid
  plan       PlanInterest
  pdf        Bytes
  created_at DateTime @default(now()) @db.Timestamptz(6)

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@map("proposals")
}

enum WebsiteStage {
  NOT_STARTED
  PROMPT_READY
  IN_DEVELOPMENT
  IN_REVIEW
  READY
  DELIVERED
}

enum OwnerCallType {
  SUMMARY   // end-of-campaign report
  UPDATE    // "Jarvis, call me now" — calls + website progress, any time
  NOTICE    // one-off news for Harsha, e.g. "Claude finished building X"
  QUOTATION // approve sending a proposal to a client
  WEBSITE   // approve sending the live website link to a client
  REEL      // approve today's Instagram reel before it's posted
  VOICE_APPROVAL // an Infinity Voice agent needs sir's decision (discount, custom quote, exception…)
}

enum OwnerCallStatus {
  QUEUED       // waiting to call Harshavardhan
  CALLING      // call placed, waiting for Sarvam's result
  APPROVED     // he said yes — the client message is being sent
  REJECTED     // he said no
  NEEDS_MANUAL // couldn't get a decision — approve/reject from the dashboard
  SENT         // approved and the client message went out
  DONE         // summary call delivered
  FAILED       // approved but sending failed (see call_logs)
  CANCELLED
}

// Calls the assistant agent places to Harshavardhan, processed one at a time.
model OwnerCall {
  id              String          @id @default(uuid()) @db.Uuid
  type            OwnerCallType
  status          OwnerCallStatus @default(QUEUED)
  client_id       String?         @db.Uuid
  campaign_id     String?         @db.Uuid
  data            Json?           // e.g. { website_url } or summary variables
  attempt_id      String?         // Sarvam attempt id of the latest call
  attempts        Int             @default(0)
  next_attempt_at DateTime        @default(now()) @db.Timestamptz(6)
  called_at       DateTime?       @db.Timestamptz(6)
  decided_at      DateTime?       @db.Timestamptz(6)
  decision_note   String?         @db.Text
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  client   Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@index([status, next_attempt_at])
  @@index([client_id])
  @@map("owner_calls")
}

// Linked-device session for sending from the owner's own WhatsApp (Baileys auth state).
// Kept in Postgres because Render's disk is wiped on every deploy.
model WaSession {
  key        String   @id // "creds" or "<type>-<id>" signal keys
  value      String   @db.Text
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("wa_session")
}

// Personal contacts Jarvis can call on sir's behalf ("call my mom and say I'll be late").
model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  name       String           // "Mom"
  aliases    String?          // comma-separated: "mother, amma, mummy"
  phone      String           // E.164
  notes      String?  @db.Text // context Jarvis may use when answering, e.g. "Speak in Kannada"
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  relay_calls RelayCall[]

  @@map("contacts")
}

// A call Jarvis places to someone to pass on sir's message.
model RelayCall {
  id         String   @id @default(uuid()) @db.Uuid
  contact_id String?  @db.Uuid
  to_name    String
  to_phone   String
  message    String   @db.Text
  status     String   @default("calling") // calling | done | no_answer | failed
  attempt_id String?
  summary    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([to_phone, status])
  @@map("relay_calls")
}

// One Instagram reel per day: Claude codes it (Remotion) in GitHub Actions → sir approves → posted at 7:30 PM.
model Reel {
  id             String    @id @default(uuid()) @db.Uuid
  day            String    @unique // YYYY-MM-DD (IST)
  status         String    @default("generating") // generating | ready | approved | rejected | posting | posted | failed
  topic          String?
  caption        String?   @db.Text
  video          Bytes?    // MP4, served publicly at /reels/:id.mp4 for Instagram to fetch (pruned after posting)
  video_size     Int?
  run_url        String?
  instructions   String?   @db.Text // sir's changes for a redo
  ig_container_id String?
  ig_media_id    String?
  ig_permalink   String?
  error          String?   @db.Text
  ready_at       DateTime? @db.Timestamptz(6)
  approved_at    DateTime? @db.Timestamptz(6)
  posted_at      DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  @@map("reels")
}

// Clips of a UGC ad uploaded one by one (by the Claude task on sir's laptop) before they are joined.
model UgcClip {
  id         String   @id @default(uuid()) @db.Uuid
  reel_id    String   @db.Uuid
  n          Int      // 1..3
  data       Bytes
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([reel_id, n])
  @@map("ugc_clips")
}

// Small key/value store for settings the server updates itself (e.g. refreshed Instagram token).
model AppSetting {
  key        String   @id
  value      String   @db.Text
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("app_settings")
}

// ── Infinity Voice ─────────────────────────────────────────────────────────────────────────
// AI phone agents that talk over sir's own phone (Bluetooth HFP via the local voice gateway).

model VoiceAgent {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  role             String   // SALES | RECEPTIONIST | FOLLOW_UP | SUPPORT
  personality      String?  @db.Text
  voice            String?  // TTS voice id on the gateway (e.g. a Piper model name)
  language         String   @default("en-IN")
  greeting         String   @db.Text
  objectives       String?  @db.Text
  escalation_rules String?  @db.Text
  allowed_tools    String[] // tool names this agent may use
  can_call_out     Boolean  @default(false)
  active           Boolean  @default(true)
  version          Int      @default(1)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  calls VoiceCall[]

  @@map("voice_agents")
}

model VoiceCall {
  id                  String    @id @default(uuid()) @db.Uuid
  agent_id            String    @db.Uuid
  client_id           String?   @db.Uuid
  direction           String    // INBOUND | OUTBOUND
  purpose             String    @default("follow_up") // follow_up | cold | support
  authorization_ref   String?   // telemarketing authorisation in force when a cold call was placed
  mode                String    // SIMULATED (test console) | LIVE (real phone line)
  phone               String?
  state               String    @default("CREATED")
  attempts            Int       @default(0)
  next_attempt_at     DateTime? @db.Timestamptz(6)
  started_at          DateTime? @db.Timestamptz(6)
  connected_at        DateTime? @db.Timestamptz(6)
  ended_at            DateTime? @db.Timestamptz(6)
  duration_seconds    Int?
  outcome             String?   // BOOKED | INTERESTED | CALLBACK | NOT_INTERESTED | OPT_OUT | NO_ANSWER | BUSY | FAILED | INFO_ONLY
  intent              String?
  summary             String?   @db.Text
  qualification_score Int?
  objections          String?   @db.Text
  next_action         String?   @db.Text
  follow_up_at        DateTime? @db.Timestamptz(6)
  transcript          Json?     // [{ role: customer|agent, text, final, at }]
  ai_messages         Json?     // model conversation state (for continuing turns)
  usage               Json?     // { input_tokens, output_tokens, turns, avg_latency_ms }
  error               String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  agent  VoiceAgent       @relation(fields: [agent_id], references: [id])
  events VoiceCallEvent[]

  @@index([state, next_attempt_at])
  @@index([client_id])
  @@index([created_at])
  @@map("voice_calls")
}

model VoiceCallEvent {
  id      String   @id @default(uuid()) @db.Uuid
  call_id String   @db.Uuid
  type    String   // STATE | TURN | TOOL | GATEWAY | ERROR | LATENCY
  data    Json?
  at      DateTime @default(now()) @db.Timestamptz(6)

  call VoiceCall @relation(fields: [call_id], references: [id], onDelete: Cascade)

  @@index([call_id, at])
  @@map("voice_call_events")
}

model VoiceKnowledge {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  content    String   @db.Text
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("voice_knowledge")
}

// Commands for the local voice gateway (it polls; the cloud never connects into sir's laptop).
model VoiceGatewayCommand {
  id         String   @id @default(uuid()) @db.Uuid
  call_id    String?  @db.Uuid
  command    String   // DIAL | ANSWER | HANGUP | REJECT
  payload    Json?
  status     String   @default("pending") // pending | sent | done | failed | expired
  result     Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("voice_gateway_commands")
}
