# Infinity Voice gateway — copy to .env and fill in. Never commit .env.
INFINITY_API_URL=https://infinity-automation-api.onrender.com
VOICE_GATEWAY_TOKEN=            # same value as VOICE_GATEWAY_TOKEN on Render
POLL_MS=2000

# CallScoot (local) — virtual PipeWire devices + optional API
CALLSCOOT_API_BASE=http://127.0.0.1:8788
CALLSCOOT_API_TOKEN=
CALLSCOOT_RX=callscoot.agent.rx.monitor
CALLSCOOT_TX=callscoot.agent.tx

# Speech (local, no hosted quotas)
WHISPER_URL=http://127.0.0.1:8080/inference   # whisper.cpp: whisper-server -m models/ggml-base.bin --port 8080
WHISPER_LANGUAGE=auto
PIPER_BIN=piper
PIPER_MODEL=/home/you/piper/en_US-lessac-low.onnx   # a 16 kHz "low" model avoids resampling
VAD_THRESHOLD=0.02
